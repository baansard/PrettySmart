<Project Sdk="Microsoft.NET.Sdk.Web">

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.AspNetCore.Authentication.JwtBearer" Version="10.0.11" />
  </ItemGroup>

  <!-- Bundle the browser game into the published app under game/ (see "GameRoot" in appsettings.json).
       While developing, the server reads the files straight from the repo instead. -->
  <ItemGroup>
    <None Include="../../index.html;../../style.css" Link="game/%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../js/**/*" Link="game/js/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
    <None Include="../../assets/**/*" Exclude="../../assets/example*" Link="game/assets/%(RecursiveDir)%(Filename)%(Extension)" CopyToPublishDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
